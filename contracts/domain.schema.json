{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "美术馆文创授权台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "RIGHT_CLAIMED",
        "DESIGN_SUBMITTED",
        "CLEARANCE_APPROVED",
        "BATCH_RELEASED",
        "RIGHT_WITHDRAWN"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "artwork_right",
        "design_proposal",
        "product_sku",
        "royalty_statement"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
